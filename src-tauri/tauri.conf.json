{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agsp-scraper",
  "version": "0.1.0",
  "identifier": "com.agsp-scraper.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AGSP Scraper",
        "width": 900,
        "height": 700,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
